@@ -0,0 +1,413 @@
+//! Opt-in server authentication and encrypted rendezvous transport.
+//! This does not validate API tokens or authorize remote-control sessions.
+
+use hbb_common::{
+    bail,
+    bytes::BytesMut,
+    protobuf::Message,
+    rendezvous_proto::{rendezvous_message, KeyExchange, KxParams, RendezvousMessage},
+    tcp::Encrypt,
+    ResultType,
+};
+use sodiumoxide::crypto::{box_, generichash, secretbox, sign};
+use std::path::Path;
+
+/// Read the persistent key before any legacy key generation can run.
+pub(crate) fn configured_signing_key(key: &str) -> ResultType<Option<sign::SecretKey>> {
+    match std::env::var("HBBS_ACCOUNT_SECURE_TCP") {
+        Err(std::env::VarError::NotPresent) => return Ok(None),
+        Ok(value) if value.is_empty() || value == "0" => return Ok(None),
+        Ok(value) if value == "1" => {}
+        _ => bail!("HBBS_ACCOUNT_SECURE_TCP must be 0 or 1"),
+    }
+    let path =
+        std::env::var_os("HBBS_ACCOUNT_SIGNING_KEY_FILE").unwrap_or_else(|| "id_ed25519".into());
+    load_signing_key(Path::new(&path), key).map(Some)
+}
+
+fn load_signing_key(path: &Path, key: &str) -> ResultType<sign::SecretKey> {
+    sodiumoxide::init().map_err(|_| hbb_common::anyhow::anyhow!("Crypto initialization failed"))?;
+    let contents = std::fs::read_to_string(path).map_err(|_| {
+        hbb_common::anyhow::anyhow!(
+            "Cannot read HBBS_ACCOUNT_SIGNING_KEY_FILE (existing key required)"
+        )
+    })?;
+    validate_signing_key(contents.trim(), key)
+}
+
+fn validate_signing_key(contents: &str, key: &str) -> ResultType<sign::SecretKey> {
+    let raw = base64::decode(contents)
+        .map_err(|_| hbb_common::anyhow::anyhow!("Signing key must be base64"))?;
+    let sk = sign::SecretKey::from_slice(&raw)
+        .ok_or_else(|| hbb_common::anyhow::anyhow!("Signing key must contain 64 bytes"))?;
+    let seed = sign::Seed::from_slice(&raw[..sign::SEEDBYTES])
+        .ok_or_else(|| hbb_common::anyhow::anyhow!("Invalid signing key seed"))?;
+    let (pk, derived_sk) = sign::keypair_from_seed(&seed);
+    if sk != derived_sk {
+        bail!("Signing key public half does not match its seed");
+    }
+    // These legacy values select the existing id_ed25519 key. In this mode
+    // derive its public key directly, without calling gen_sk's creation path.
+    if key != "-" && key != "_" {
+        let configured = base64::decode(key)
+            .map_err(|_| hbb_common::anyhow::anyhow!("Configured -k must match signing key"))?;
+        if configured.as_slice() != pk.as_ref() && configured.as_slice() != sk.as_ref() {
+            bail!("Configured -k does not match signing key");
+        }
+    }
+    Ok(sk)
+}
+
+pub(crate) fn public_key(sk: &sign::SecretKey) -> String {
+    base64::encode(&sk.as_ref()[sign::SEEDBYTES..])
+}
+
+pub(crate) struct Handshake {
+    secret_key: box_::SecretKey,
+    public_key: box_::PublicKey,
+}
+
+pub(crate) struct Session {
+    pub(crate) send: Encrypt,
+    pub(crate) receive: Encrypt,
+}
+
+impl Handshake {
+    pub(crate) fn new(sk: &sign::SecretKey) -> ResultType<(Self, RendezvousMessage)> {
+        let (mut pk, secret_key) = box_::gen_keypair();
+        // X25519 ignores this bit; the client treats it as a requirement to
+        // verify the signed version parameters rather than accepting v0.
+        pk.0[31] |= 0x80;
+        let params = KxParams {
+            pk: pk.as_ref().to_vec().into(),
+            version: 1,
+            ..Default::default()
+        };
+        let mut signed_params = b"rdkx-params".to_vec();
+        signed_params.extend_from_slice(&params.write_to_bytes()?);
+        let mut msg = RendezvousMessage::new();
+        msg.set_key_exchange(KeyExchange {
+            keys: vec![sign::sign(pk.as_ref(), sk).into()],
+            version: 1,
+            signed_params: sign::sign(&signed_params, sk).into(),
+            ..Default::default()
+        });
+        Ok((
+            Self {
+                secret_key,
+                public_key: pk,
+            },
+            msg,
+        ))
+    }
+
+    /// A first business frame keeps the connection plaintext. Only an explicit
+    /// KeyExchange selects encryption; a malformed exchange closes it.
+    pub(crate) fn accept_first(self, bytes: &[u8]) -> ResultType<Option<Session>> {
+        let msg = RendezvousMessage::parse_from_bytes(bytes)?;
+        if let Some(rendezvous_message::Union::KeyExchange(exchange)) = msg.union {
+            if exchange.version != 1 || exchange.keys.len() != 2 {
+                bail!("Invalid account secure TCP key exchange");
+            }
+            let shared = Encrypt::decode(&exchange.keys[1], &exchange.keys[0], &self.secret_key)?;
+            return Ok(Some(Session {
+                send: Encrypt::new(direction_key(
+                    &shared,
+                    2,
+                    &exchange.keys[0],
+                    self.public_key.as_ref(),
+                )?),
+                receive: Encrypt::new(direction_key(
+                    &shared,
+                    1,
+                    &exchange.keys[0],
+                    self.public_key.as_ref(),
+                )?),
+            }));
+        }
+        Ok(None)
+    }
+}
+
+// Official hbb_common v1: keyed BLAKE2b-256 over the direction and the
+// authenticated negotiation transcript. The shared key is the BLAKE2b key.
+fn direction_key(
+    shared: &secretbox::Key,
+    direction: u8,
+    client_pk: &[u8],
+    server_pk: &[u8],
+) -> ResultType<secretbox::Key> {
+    let mut input = b"rdkx-spl".to_vec();
+    input.push(direction);
+    input.extend_from_slice(&1u32.to_le_bytes()); // advertised version
+    input.extend_from_slice(&1u32.to_le_bytes()); // selected version
+    input.extend_from_slice(client_pk);
+    input.extend_from_slice(server_pk);
+    let mut hash = generichash::State::new(Some(secretbox::KEYBYTES), Some(shared.as_ref()))
+        .map_err(|_| hbb_common::anyhow::anyhow!("Account secure TCP key derivation failed"))?;
+    hash.update(&input)
+        .map_err(|_| hbb_common::anyhow::anyhow!("Account secure TCP key derivation failed"))?;
+    let digest = hash
+        .finalize()
+        .map_err(|_| hbb_common::anyhow::anyhow!("Account secure TCP key derivation failed"))?;
+    secretbox::Key::from_slice(digest.as_ref())
+        .ok_or_else(|| hbb_common::anyhow::anyhow!("Invalid derived key length"))
+}
+
+pub(crate) fn decrypt(encrypt: &mut Encrypt, bytes: &mut BytesMut) -> ResultType<()> {
+    // The caller handles empty control frames without advancing the counter.
+    // Encrypt::dec also permits one-byte plaintext, which rendezvous must reject.
+    if bytes.len() < secretbox::MACBYTES {
+        bail!("Account secure TCP frame is too short");
+    }
+    encrypt.dec(bytes)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hbb_common::rendezvous_proto::{PunchHoleRequest, TestNatRequest};
+
+    fn exchange() -> (Session, secretbox::Key, secretbox::Key) {
+        sodiumoxide::init().unwrap();
+        let (pk, sk) = sign::gen_keypair();
+        let (handshake, offer) = Handshake::new(&sk).unwrap();
+        let signed = &offer.key_exchange().keys;
+        assert_eq!(signed.len(), 1);
+        let ephemeral = sign::verify(&signed[0], &pk).unwrap();
+        assert_eq!(ephemeral.len(), box_::PUBLICKEYBYTES);
+        assert_ne!(ephemeral[31] & 0x80, 0);
+        assert_eq!(offer.key_exchange().version, 1);
+        let signed_params = sign::verify(&offer.key_exchange().signed_params, &pk).unwrap();
+        assert!(signed_params.starts_with(b"rdkx-params"));
+        let params = KxParams::parse_from_bytes(&signed_params[b"rdkx-params".len()..]).unwrap();
+        assert_eq!(params.pk.as_ref(), ephemeral.as_slice());
+        assert_eq!(params.version, 1);
+        let server_pk = box_::PublicKey::from_slice(&ephemeral).unwrap();
+        let (client_pk, client_sk) = box_::gen_keypair();
+        let key = secretbox::gen_key();
+        let sealed = box_::seal(
+            key.as_ref(),
+            &box_::Nonce([0; box_::NONCEBYTES]),
+            &server_pk,
+            &client_sk,
+        );
+        let mut answer = RendezvousMessage::new();
+        answer.set_key_exchange(KeyExchange {
+            keys: vec![client_pk.as_ref().to_vec().into(), sealed.into()],
+            version: 1,
+            ..Default::default()
+        });
+        let encrypt = handshake
+            .accept_first(&answer.write_to_bytes().unwrap())
+            .unwrap()
+            .unwrap();
+        (
+            encrypt,
+            direction_key(&key, 1, client_pk.as_ref(), &ephemeral).unwrap(),
+            direction_key(&key, 2, client_pk.as_ref(), &ephemeral).unwrap(),
+        )
+    }
+
+    fn nonce(counter: u64) -> secretbox::Nonce {
+        let mut nonce = secretbox::Nonce([0; secretbox::NONCEBYTES]);
+        nonce.0[..8].copy_from_slice(&counter.to_le_bytes());
+        nonce
+    }
+
+    #[test]
+    fn signed_exchange_and_independent_ordered_counters() {
+        let (mut session, client_send, client_receive) = exchange();
+        for counter in 1..=3 {
+            let mut frame = BytesMut::from(
+                secretbox::seal(b"client request", &nonce(counter), &client_send).as_slice(),
+            );
+            decrypt(&mut session.receive, &mut frame).unwrap();
+            assert_eq!(frame.as_ref(), b"client request");
+            assert_eq!(
+                secretbox::open(
+                    &session.send.enc(b"async response"),
+                    &nonce(counter),
+                    &client_receive
+                )
+                .unwrap(),
+                b"async response"
+            );
+        }
+    }
+
+    #[test]
+    fn tampered_replayed_and_short_ciphertext_are_rejected() {
+        let (session, key, _) = exchange();
+        let mut encrypt = session.receive;
+        let sealed = secretbox::seal(b"request", &nonce(1), &key);
+        decrypt(&mut encrypt, &mut BytesMut::from(sealed.as_slice())).unwrap();
+        assert!(decrypt(&mut encrypt, &mut BytesMut::from(sealed.as_slice())).is_err());
+        let (session, _, _) = exchange();
+        let mut encrypt = session.receive;
+        assert!(decrypt(&mut encrypt, &mut BytesMut::from(&b"x"[..])).is_err());
+        assert!(decrypt(&mut encrypt, &mut BytesMut::from(&[0u8; 32][..])).is_err());
+    }
+
+    #[test]
+    fn non_keyexchange_first_frames_remain_plaintext() {
+        sodiumoxide::init().unwrap();
+        let (_, sk) = sign::gen_keypair();
+        let mut punch = RendezvousMessage::new();
+        punch.set_punch_hole_request(PunchHoleRequest::new());
+        let mut nat = RendezvousMessage::new();
+        nat.set_test_nat_request(TestNatRequest::new());
+        for msg in [punch, nat] {
+            let bytes = msg.write_to_bytes().unwrap();
+            let (handshake, _) = Handshake::new(&sk).unwrap();
+            assert!(handshake.accept_first(&bytes).unwrap().is_none());
+            assert_eq!(RendezvousMessage::parse_from_bytes(&bytes).unwrap(), msg);
+        }
+    }
+
+    #[test]
+    fn malformed_exchange_is_rejected() {
+        sodiumoxide::init().unwrap();
+        let (_, sk) = sign::gen_keypair();
+        for keys in [
+            vec![],
+            vec![vec![0; 32]],
+            vec![vec![0; 32], vec![0; 48]],
+            vec![vec![0; 31], vec![0; 48]],
+        ] {
+            let (handshake, _) = Handshake::new(&sk).unwrap();
+            let mut msg = RendezvousMessage::new();
+            msg.set_key_exchange(KeyExchange {
+                keys: keys.into_iter().map(Into::into).collect(),
+                version: 1,
+                ..Default::default()
+            });
+            assert!(handshake
+                .accept_first(&msg.write_to_bytes().unwrap())
+                .is_err());
+        }
+    }
+
+    #[test]
+    fn authenticated_box_with_wrong_secretbox_key_length_is_rejected() {
+        sodiumoxide::init().unwrap();
+        let (pk, sk) = sign::gen_keypair();
+        let (handshake, offer) = Handshake::new(&sk).unwrap();
+        let ephemeral = sign::verify(&offer.key_exchange().keys[0], &pk).unwrap();
+        let server_pk = box_::PublicKey::from_slice(&ephemeral).unwrap();
+        let (client_pk, client_sk) = box_::gen_keypair();
+        let sealed = box_::seal(
+            &[0; secretbox::KEYBYTES - 1],
+            &box_::Nonce([0; box_::NONCEBYTES]),
+            &server_pk,
+            &client_sk,
+        );
+        let mut answer = RendezvousMessage::new();
+        answer.set_key_exchange(KeyExchange {
+            keys: vec![client_pk.as_ref().to_vec().into(), sealed.into()],
+            version: 1,
+            ..Default::default()
+        });
+        assert!(handshake
+            .accept_first(&answer.write_to_bytes().unwrap())
+            .is_err());
+    }
+
+    #[test]
+    fn offer_rejects_wrong_identity_and_tampering() {
+        sodiumoxide::init().unwrap();
+        let (pk, sk) = sign::gen_keypair();
+        let (_, offer) = Handshake::new(&sk).unwrap();
+        let signed = &offer.key_exchange().keys[0];
+        let (other_pk, _) = sign::gen_keypair();
+        assert!(sign::verify(signed, &other_pk).is_err());
+        let mut tampered = signed.to_vec();
+        tampered[0] ^= 1;
+        assert!(sign::verify(&tampered, &pk).is_err());
+        assert!(sign::verify(&offer.key_exchange().signed_params, &other_pk).is_err());
+        let mut tampered = offer.key_exchange().signed_params.to_vec();
+        tampered[0] ^= 1;
+        assert!(sign::verify(&tampered, &pk).is_err());
+    }
+
+    #[test]
+    fn official_v1_direction_key_golden_vectors() {
+        sodiumoxide::init().unwrap();
+        let shared = secretbox::Key([0x11; 32]);
+        let client = [0x22; 32];
+        let server = [0x33; 32];
+        let hex = |bytes: &[u8]| {
+            bytes
+                .iter()
+                .map(|byte| format!("{byte:02x}"))
+                .collect::<String>()
+        };
+        assert_eq!(
+            hex(direction_key(&shared, 1, &client, &server)
+                .unwrap()
+                .as_ref()),
+            "c189ec6e1935c0751cfc85a0f075405cae507d7925bb19687caf56cbb54e0ecf"
+        );
+        assert_eq!(
+            hex(direction_key(&shared, 2, &client, &server)
+                .unwrap()
+                .as_ref()),
+            "8a62648e9195cb10ea900c0a24d2a166c1e982347a2dc6833c3e756bf5715d36"
+        );
+    }
+
+    #[test]
+    fn outgoing_ciphertext_cannot_be_reflected_as_incoming() {
+        let (mut session, _, _) = exchange();
+        let mut reflected = BytesMut::from(session.send.enc(b"response").as_slice());
+        assert!(decrypt(&mut session.receive, &mut reflected).is_err());
+    }
+
+    #[test]
+    fn downgrade_and_unsupported_versions_are_rejected_before_box_decode() {
+        sodiumoxide::init().unwrap();
+        let (_, sk) = sign::gen_keypair();
+        for version in [0, 2, 3, u32::MAX] {
+            let (handshake, _) = Handshake::new(&sk).unwrap();
+            let mut reply = RendezvousMessage::new();
+            reply.set_key_exchange(KeyExchange {
+                keys: vec![vec![0; 32].into(), vec![0; 48].into()],
+                version,
+                ..Default::default()
+            });
+            let err = handshake
+                .accept_first(&reply.write_to_bytes().unwrap())
+                .err()
+                .unwrap();
+            assert_eq!(err.to_string(), "Invalid account secure TCP key exchange");
+        }
+    }
+
+    #[test]
+    fn persistent_signing_key_must_be_valid_and_match_configured_key() {
+        sodiumoxide::init().unwrap();
+        let (pk, sk) = sign::gen_keypair();
+        let encoded = base64::encode(sk.as_ref());
+        for configured in [
+            "-".to_owned(),
+            "_".to_owned(),
+            base64::encode(pk.as_ref()),
+            encoded.clone(),
+        ] {
+            assert!(validate_signing_key(&encoded, &configured).is_ok());
+        }
+        assert!(validate_signing_key(&encoded, "").is_err());
+        assert!(validate_signing_key("bad base64", "-").is_err());
+        assert!(validate_signing_key(&base64::encode([0; 32]), "-").is_err());
+        let mut bad = sk.as_ref().to_vec();
+        bad[63] ^= 1;
+        assert!(validate_signing_key(&base64::encode(bad), "-").is_err());
+        let (other_pk, _) = sign::gen_keypair();
+        assert!(validate_signing_key(&encoded, &base64::encode(other_pk.as_ref())).is_err());
+        let missing =
+            std::env::temp_dir().join(format!("hbbs-missing-key-{}", uuid::Uuid::new_v4()));
+        assert!(load_signing_key(&missing, "-").is_err());
+        assert!(!missing.exists());
+    }
+}
