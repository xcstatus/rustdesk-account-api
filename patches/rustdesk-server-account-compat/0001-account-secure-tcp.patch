+#[cfg(test)]
+mod account_secure_tcp_tests {
+    use super::*;
+    use sodiumoxide::crypto::secretbox;
+
+    #[tokio::test]
+    async fn cached_sink_preserves_encrypted_response_order() {
+        sodiumoxide::init().unwrap();
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let (client, accepted) = tokio::join!(TcpStream::connect(addr), listener.accept());
+        let (server, peer) = accepted.unwrap();
+        let (send, _receive) = Framed::new(server, BytesCodec::new()).split();
+        let mut client = Framed::new(client.unwrap(), BytesCodec::new());
+        let key = secretbox::gen_key();
+        let mut sink = Some(Sink::TcpStream(send, Some(Encrypt::new(key.clone()))));
+        let mut response = RendezvousMessage::new();
+        response.set_punch_hole_response(PunchHoleResponse::new());
+        RendezvousServer::send_to_sink(&mut sink, response.clone()).await;
+
+        // Move the same send state through the cache and into a spawned task,
+        // as send_to_tcp does for a delayed PunchHoleResponse.
+        let mut cache = HashMap::new();
+        cache.insert(peer, sink.take().unwrap());
+        let mut cached = cache.remove(&peer);
+        let expected = response.write_to_bytes().unwrap();
+        let task = tokio::spawn(async move {
+            RendezvousServer::send_to_sink(&mut cached, response).await;
+        });
+        for counter in 1u64..=2 {
+            let frame = timeout(1_000, client.next()).await.unwrap().unwrap().unwrap();
+            let mut nonce = secretbox::Nonce([0; secretbox::NONCEBYTES]);
+            nonce.0[..8].copy_from_slice(&counter.to_le_bytes());
+            assert_eq!(secretbox::open(&frame, &nonce, &key).unwrap(), expected);
+        }
+        task.await.unwrap();
+    }
+}
