+#[test]
+fn missing_or_mismatched_persistent_key_fails_without_generating_keys() {
+    sodiumoxide::init().unwrap();
+    for missing in [true, false] {
+        let dir = TestDir::new();
+        let keyfile = dir.path().join("existing-signing-key");
+        let (pk, sk) = sign::gen_keypair();
+        if !missing {
+            fs::write(&keyfile, base64::encode(sk.as_ref())).unwrap();
+        }
+        let expected = if missing { pk } else { sign::gen_keypair().0 };
+        let status = command(
+            dir.path(),
+            unused_port(),
+            &base64::encode(expected.as_ref()),
+        )
+        .env("HBBS_ACCOUNT_SECURE_TCP", "1")
+        .env("HBBS_ACCOUNT_SIGNING_KEY_FILE", &keyfile)
+        .status()
+        .unwrap();
+        assert!(!status.success());
+        assert!(!dir.path().join("id_ed25519").exists());
+        assert!(!dir.path().join("id_ed25519.pub").exists());
+    }
+}
