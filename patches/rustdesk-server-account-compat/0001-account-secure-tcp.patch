--- /dev/null
+++ b/tests/account_secure_tcp.rs
@@ -0,0 +1,436 @@
+//! Real hbbs-process regression tests using the official hbb_common framing.
+use hbb_common::{
+    protobuf::Message,
+    rendezvous_proto::*,
+    tcp::{Encrypt, FramedStream},
+    tokio::{
+        self,
+        net::UdpSocket,
+        time::{sleep, timeout, Duration},
+    },
+    AddrMangle,
+};
+use sodiumoxide::crypto::{box_, generichash, secretbox, sign};
+use std::{
+    fs::{self, File},
+    net::{SocketAddr, TcpListener},
+    process::{Child, Command, Stdio},
+};
+
+struct Server {
+    child: Child,
+    dir: TestDir,
+    port: u16,
+    pk: sign::PublicKey,
+}
+
+struct TestDir(std::path::PathBuf);
+
+impl TestDir {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!("hbbs-compat-test-{}", uuid::Uuid::new_v4()));
+        let mut builder = fs::DirBuilder::new();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        builder.create(&path).unwrap();
+        Self(path)
+    }
+
+    fn path(&self) -> &std::path::Path {
+        &self.0
+    }
+}
+
+impl Drop for TestDir {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+fn unused_port() -> u16 {
+    for _ in 0..100 {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        if port < 1025 || port > 65532 {
+            continue;
+        }
+        if let (Ok(_nat), Ok(_ws), Ok(_udp)) = (
+            TcpListener::bind(("127.0.0.1", port - 1)),
+            TcpListener::bind(("127.0.0.1", port + 2)),
+            std::net::UdpSocket::bind(("127.0.0.1", port)),
+        ) {
+            return port;
+        }
+    }
+    panic!("no isolated test ports available");
+}
+
+fn command(dir: &std::path::Path, port: u16, key: &str) -> Command {
+    let mut command = Command::new(env!("CARGO_BIN_EXE_hbbs"));
+    // Do not inherit real service environment or a database destination.
+    command
+        .env_clear()
+        .current_dir(dir)
+        .args(["-p", &port.to_string(), "-k", key])
+        .stdout(Stdio::from(File::create(dir.join("stdout.log")).unwrap()))
+        .stderr(Stdio::from(File::create(dir.join("stderr.log")).unwrap()));
+    command
+}
+
+async fn start(enabled: bool) -> Server {
+    sodiumoxide::init().unwrap();
+    let dir = TestDir::new();
+    let (pk, sk) = sign::gen_keypair();
+    let path = dir.path().join("existing-signing-key");
+    fs::write(&path, base64::encode(sk.as_ref())).unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+    }
+    let port = unused_port();
+    let mut command = command(dir.path(), port, &base64::encode(pk.as_ref()));
+    if enabled {
+        command
+            .env("HBBS_ACCOUNT_SECURE_TCP", "1")
+            .env("HBBS_ACCOUNT_SIGNING_KEY_FILE", &path);
+    }
+    let mut child = command.spawn().unwrap();
+    for _ in 0..100 {
+        if let Some(status) = child.try_wait().unwrap() {
+            panic!(
+                "isolated hbbs exited {status}: {}",
+                fs::read_to_string(dir.path().join("stderr.log")).unwrap()
+            );
+        }
+        if tokio::net::TcpStream::connect(("127.0.0.1", port))
+            .await
+            .is_ok()
+        {
+            return Server {
+                child,
+                dir,
+                port,
+                pk,
+            };
+        }
+        sleep(Duration::from_millis(50)).await;
+    }
+    let _ = child.kill();
+    let _ = child.wait();
+    panic!("isolated hbbs did not become ready");
+}
+
+struct ProbeStream {
+    stream: FramedStream,
+    send: Option<Encrypt>,
+    receive: Option<Encrypt>,
+}
+
+impl ProbeStream {
+    async fn send(&mut self, message: &RendezvousMessage) {
+        let plain = message.write_to_bytes().unwrap();
+        let wire = match &mut self.send {
+            Some(cipher) => cipher.enc(&plain),
+            None => plain,
+        };
+        self.stream.send_raw(wire).await.unwrap();
+    }
+}
+
+async fn read(stream: &mut ProbeStream) -> RendezvousMessage {
+    let mut bytes = stream
+        .stream
+        .next_timeout(3000)
+        .await
+        .expect("response timeout")
+        .expect("frame read failed");
+    if let Some(cipher) = &mut stream.receive {
+        cipher.dec(&mut bytes).unwrap();
+    }
+    RendezvousMessage::parse_from_bytes(&bytes).expect("invalid response protobuf")
+}
+
+// Independent official-client reference, pinned hbb_common 229b904508364c8997aad0fb5af57effac859f60:
+// src/tcp.rs:320-356, with the upstream golden vector checked below.
+fn client_key(
+    shared: &secretbox::Key,
+    direction: u8,
+    client_pk: &[u8],
+    server_pk: &[u8],
+) -> secretbox::Key {
+    let mut hash = generichash::State::new(Some(32), Some(shared.as_ref())).unwrap();
+    hash.update(b"rdkx-spl").unwrap();
+    hash.update(&[direction]).unwrap();
+    hash.update(&1u32.to_le_bytes()).unwrap();
+    hash.update(&1u32.to_le_bytes()).unwrap();
+    hash.update(client_pk).unwrap();
+    hash.update(server_pk).unwrap();
+    secretbox::Key::from_slice(hash.finalize().unwrap().as_ref()).unwrap()
+}
+
+#[test]
+fn client_reference_matches_official_directional_key_vectors() {
+    let shared = secretbox::Key([0x11; 32]);
+    let hex = |key: secretbox::Key| {
+        key.as_ref()
+            .iter()
+            .map(|x| format!("{x:02x}"))
+            .collect::<String>()
+    };
+    assert_eq!(
+        hex(client_key(&shared, 1, &[0x22; 32], &[0x33; 32])),
+        "c189ec6e1935c0751cfc85a0f075405cae507d7925bb19687caf56cbb54e0ecf"
+    );
+    assert_eq!(
+        hex(client_key(&shared, 2, &[0x22; 32], &[0x33; 32])),
+        "8a62648e9195cb10ea900c0a24d2a166c1e982347a2dc6833c3e756bf5715d36"
+    );
+}
+
+async fn connect(server: &Server, encrypted: bool) -> ProbeStream {
+    let stream = FramedStream::new(format!("127.0.0.1:{}", server.port), None, 3000)
+        .await
+        .unwrap();
+    let mut stream = ProbeStream {
+        stream,
+        send: None,
+        receive: None,
+    };
+    let offer = read(&mut stream).await;
+    assert!(matches!(
+        offer.union,
+        Some(rendezvous_message::Union::KeyExchange(_))
+    ));
+    let keys = &offer.key_exchange().keys;
+    assert_eq!(keys.len(), 1);
+    let ephemeral = sign::verify(&keys[0], &server.pk).unwrap();
+    let wrong_pk = sign::gen_keypair().0;
+    assert!(sign::verify(&keys[0], &wrong_pk).is_err());
+    assert_eq!(offer.key_exchange().version, 1);
+    assert_ne!(ephemeral[31] & 0x80, 0);
+    let parameters = sign::verify(&offer.key_exchange().signed_params, &server.pk).unwrap();
+    let parameters = parameters.strip_prefix(b"rdkx-params").unwrap();
+    let parameters = KxParams::parse_from_bytes(parameters).unwrap();
+    assert_eq!(parameters.pk.as_ref(), ephemeral.as_slice());
+    assert_eq!(parameters.version, 1);
+    let remote_pk = box_::PublicKey::from_slice(&ephemeral).unwrap();
+    if encrypted {
+        let (pk, sk) = box_::gen_keypair();
+        let key = secretbox::gen_key();
+        let mut reply = RendezvousMessage::new();
+        reply.set_key_exchange(KeyExchange {
+            keys: vec![
+                pk.as_ref().to_vec().into(),
+                box_::seal(
+                    key.as_ref(),
+                    &box_::Nonce([0; box_::NONCEBYTES]),
+                    &remote_pk,
+                    &sk,
+                )
+                .into(),
+            ],
+            version: 1,
+            ..Default::default()
+        });
+        stream.send(&reply).await;
+        stream.send = Some(Encrypt::new(client_key(&key, 1, pk.as_ref(), &ephemeral)));
+        stream.receive = Some(Encrypt::new(client_key(&key, 2, pk.as_ref(), &ephemeral)));
+    }
+    stream
+}
+
+async fn test_nat(stream: &mut ProbeStream) {
+    let mut request = RendezvousMessage::new();
+    request.set_test_nat_request(TestNatRequest::default());
+    stream.send(&request).await;
+    let response = read(stream).await;
+    assert!(matches!(
+        response.union,
+        Some(rendezvous_message::Union::TestNatResponse(_))
+    ));
+    assert!(response.test_nat_response().port > 0);
+}
+
+#[tokio::test]
+async fn encrypted_and_legacy_connections_share_the_existing_server_key() {
+    let server = start(true).await;
+    let mut encrypted = connect(&server, true).await;
+    encrypted.stream.send_raw(Vec::new()).await.unwrap();
+    test_nat(&mut encrypted).await;
+    test_nat(&mut connect(&server, false).await).await;
+    assert!(
+        !server.dir.path().join("id_ed25519").exists(),
+        "must not generate a replacement key"
+    );
+}
+
+#[tokio::test]
+async fn explicit_legacy_exchange_cannot_downgrade_the_encrypted_connection() {
+    let server = start(true).await;
+    let stream = FramedStream::new(format!("127.0.0.1:{}", server.port), None, 3000)
+        .await
+        .unwrap();
+    let mut stream = ProbeStream {
+        stream,
+        send: None,
+        receive: None,
+    };
+    let offer = read(&mut stream).await;
+    let ephemeral = sign::verify(&offer.key_exchange().keys[0], &server.pk).unwrap();
+    let server_pk = box_::PublicKey::from_slice(&ephemeral).unwrap();
+    let (client_pk, client_sk) = box_::gen_keypair();
+    let mut reply = RendezvousMessage::new();
+    reply.set_key_exchange(KeyExchange {
+        keys: vec![
+            client_pk.as_ref().to_vec().into(),
+            box_::seal(
+                secretbox::gen_key().as_ref(),
+                &box_::Nonce([0; box_::NONCEBYTES]),
+                &server_pk,
+                &client_sk,
+            )
+            .into(),
+        ],
+        version: 0,
+        ..Default::default()
+    });
+    stream.send(&reply).await;
+    let result = timeout(Duration::from_secs(2), stream.stream.next())
+        .await
+        .expect("downgrade must close promptly");
+    assert!(result.is_none() || result.unwrap().is_err());
+}
+
+#[tokio::test]
+async fn disabled_mode_keeps_original_plaintext_first_message_behavior() {
+    let server = start(false).await;
+    let stream = FramedStream::new(format!("127.0.0.1:{}", server.port), None, 3000)
+        .await
+        .unwrap();
+    let mut stream = ProbeStream {
+        stream,
+        send: None,
+        receive: None,
+    };
+    test_nat(&mut stream).await;
+}
+
+#[tokio::test]
+async fn encrypted_punch_response_uses_the_cached_connection_sink() {
+    let server = start(true).await;
+    let target = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let mut register = RendezvousMessage::new();
+    register.set_register_pk(RegisterPk {
+        id: "probe-target".into(),
+        uuid: vec![7; 16].into(),
+        pk: vec![8; 32].into(),
+        ..Default::default()
+    });
+    target
+        .send_to(
+            &register.write_to_bytes().unwrap(),
+            ("127.0.0.1", server.port),
+        )
+        .await
+        .unwrap();
+    let mut buffer = [0; 8192];
+    let (len, _) = timeout(Duration::from_secs(3), target.recv_from(&mut buffer))
+        .await
+        .unwrap()
+        .unwrap();
+    let registered = RendezvousMessage::parse_from_bytes(&buffer[..len]).unwrap();
+    assert!(matches!(
+        registered.union,
+        Some(rendezvous_message::Union::RegisterPkResponse(_))
+    ));
+    assert_eq!(
+        registered
+            .register_pk_response()
+            .result
+            .enum_value()
+            .unwrap(),
+        register_pk_response::Result::OK
+    );
+
+    let mut controller = connect(&server, true).await;
+    let mut punch = RendezvousMessage::new();
+    punch.set_punch_hole_request(PunchHoleRequest {
+        id: "probe-target".into(),
+        licence_key: base64::encode(server.pk.as_ref()),
+        token: "probe-account-token".into(),
+        ..Default::default()
+    });
+    controller.send(&punch).await;
+    let (len, _) = timeout(Duration::from_secs(3), target.recv_from(&mut buffer))
+        .await
+        .unwrap()
+        .unwrap();
+    let fetch = RendezvousMessage::parse_from_bytes(&buffer[..len]).unwrap();
+    assert!(matches!(
+        fetch.union,
+        Some(rendezvous_message::Union::FetchLocalAddr(_))
+    ));
+    let target_addr: SocketAddr = "127.0.0.1:40001".parse().unwrap();
+    let encoded_addr = AddrMangle::encode(target_addr);
+    let mut local = RendezvousMessage::new();
+    local.set_local_addr(LocalAddr {
+        socket_addr: fetch.fetch_local_addr().socket_addr.clone(),
+        local_addr: encoded_addr.clone().into(),
+        id: "probe-target".into(),
+        ..Default::default()
+    });
+    let mut responder = connect(&server, false).await;
+    responder.send(&local).await;
+    let response = read(&mut controller).await;
+    assert!(matches!(
+        response.union,
+        Some(rendezvous_message::Union::PunchHoleResponse(_))
+    ));
+    assert!(response.punch_hole_response().is_local());
+    assert_eq!(
+        response.punch_hole_response().socket_addr.as_ref(),
+        encoded_addr.as_slice()
+    );
+    for name in ["stdout.log", "stderr.log"] {
+        assert!(!fs::read_to_string(server.dir.path().join(name))
+            .unwrap()
+            .contains("probe-account-token"));
+    }
+}
