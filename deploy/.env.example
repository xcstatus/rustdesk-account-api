# Copy to deploy/.env. Only non-secret settings belong here.
RD_DOMAIN=accounts.example.com
RD_WEB_ORIGIN=https://accounts.example.com
ACME_EMAIL=admin@example.com
# Production: leave empty. Local HTTPS: tls internal
CADDY_TLS_DIRECTIVE=
RD_HTTPS_BIND=443
RD_HTTP_BIND=80
RD_API_IMAGE=rustdesk-account-api:0.1.0-devices
CADDY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:16-alpine
RD_SECRETS_DIR=./.secrets
# Optional compose.book-credentials.yml only; path, never the key JSON itself.
RD_BOOK_KEYS_HOST_FILE=./.secrets/book_keys.json
# Must be unique per deployment / restoration.
RD_DATA_VOLUME=rustdesk-accounts-data
RD_POSTGRES_VOLUME=rustdesk-accounts-postgres
RD_CADDY_VOLUME=rustdesk-accounts-caddy
RD_AUDIT_RETENTION_DAYS=90
RD_LOGIN_WINDOW_SECONDS=60
RD_LOGIN_PER_ACCOUNT=10
RD_LOGIN_GLOBAL=300
RD_LOGIN_MAX_KEYS=1024
# Used only with compose.oidc.yml. Use the same HTTPS hostname as the browser.
RD_OIDC_ISSUER=https://idp.example.com/realms/company
RD_OIDC_CLIENT_ID=rustdesk-accounts
RD_OIDC_CLAIM_PATH=groups
RD_OIDC_ADMIN_VALUES=rustdesk-admin
RD_OIDC_MEMBER_VALUES=rustdesk-member
RD_OIDC_UNMATCHED=deny
